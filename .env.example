# Copy this file to .env.local and fill in real values.
# Never commit .env.local — secrets stay out of the repo (Section 36).

# GitHub Explorer (optional — public repo reads work unauthenticated too,
# but a token raises the rate limit and allows private-repo scoping later)
GITHUB_TOKEN=

# Portfolio AI Assistant ("Ask Ryan's Portfolio") — only needed once the
# assistant moves past the deterministic FAQ fallback (Section 15)
AI_PROVIDER_API_KEY=

# Contact form delivery (e.g. Resend, SendGrid, or an SMTP relay)
CONTACT_FORM_EMAIL_API_KEY=

# Analytics (Section 33) — set only one provider
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
